# Bot token, created with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Lidarr
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=

# Comma-separated whitelisted chat/channel ids (use /id in the bot to discover them).
# Channels have negative ids, e.g. -1001234567890
ALLOWED_CHAT_IDS=

# (optional) your Telegram user id: can use /allow and /deny and message the bot anywhere
ADMIN_USER_ID=

# Bot language for user-facing messages: en | it
BOT_LANG=en

# (optional) when empty the first root folder / profiles in Lidarr are used
LIDARR_ROOT_FOLDER=
LIDARR_QUALITY_PROFILE=
LIDARR_METADATA_PROFILE=

# In groups: "smart" (default) answers only to links, @mentions, replies to the
# bot and /add; "all" answers to every message.
GROUP_TRIGGER=smart

# Post in the chat when an album added from Telegram has been imported.
NOTIFY_ON_IMPORT=true
# Stop tracking an album after this many days (default 7).
NOTIFY_MAX_DAYS=7
# Seconds between checks (default 120, minimum 30).
NOTIFY_INTERVAL=120

# (Docker only) user/group the bot runs as; /data is chowned to it at startup.
PUID=1000
PGID=1000

# DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
